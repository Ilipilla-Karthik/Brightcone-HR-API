# Brightcone HR Portal - Backend Environment Template

# Option A: Local PostgreSQL
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5435/brightcone_hr_portal

# Option B: Supabase Hosted PostgreSQL
# DATABASE_URL=postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Web Server
PORT=5155
BINDING=127.0.0.1
APP_ENV=development
LOG_LEVEL=debug

# Connection Pool Settings
DB_LOGGING=false
DB_CONNECT_TIMEOUT=5000
DB_IDLE_TIMEOUT=5000
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=10

# Authentication & Session (Must be valid Base64 string for Loco)
JWT_SECRET=y2dMj3YjaprfSmdkXDhB
JWT_EXPIRATION=604800

# Allowed Frontend Origins
FRONTEND_URL=http://127.0.0.1:5173

# Business Rules & Timezone Handling (Fixed Offset or Supported IANA Name)
# Configures the business timezone for date-only learning deadlines and overdue flags.
# Converts current UTC instant to this timezone before evaluating calendar due dates.
# Supported formats: "+05:30", "Asia/Kolkata", "IST", "UTC". Default: "+05:30".
BUSINESS_TIMEZONE=+05:30
