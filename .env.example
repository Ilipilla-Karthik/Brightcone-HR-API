# PostgreSQL Database Connection Link
DATABASE_URL=postgres://postgres:<password>@127.0.0.1:5433/brightcone_recruitment

# Individual Database Parameters
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=<password>
DB_NAME=brightcone_recruitment

PORT=5150
BINDING=localhost
ENVIRONMENT=development
LOG_LEVEL=debug
